rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSuperAdmin() { return signedIn() && request.auth.token.superAdmin == true; }
    function businessId() { return request.auth.token.businessId; }
    function belongsTo(id) { return signedIn() && (isSuperAdmin() || businessId() == id); }
    function access(id) { return get(/databases/$(database)/documents/businessAccessControls/$(id)).data; }
    function canRead(id) { return belongsTo(id) && access(id).accessStatus in ['active', 'read-only', 'suspended']; }
    function canWrite(id) {
      return belongsTo(id)
        && access(id).accessStatus == 'active'
        && get(/databases/$(database)/documents/platformSettings/global).data.features.inventoryUpdates == true
        && get(/databases/$(database)/documents/platformSettings/global).data.maintenanceMode != true;
    }

    match /businesses/{id} {
      allow read: if belongsTo(id);
      allow write: if false;
      match /items/{itemId} {
        allow read: if canRead(id);
        allow create, update, delete: if canWrite(id);
      }
      match /{document=**} {
        allow read: if canRead(id);
        allow write: if canWrite(id);
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    match /platformSettings/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /businessAccessControls/{id} {
      allow read: if belongsTo(id);
      allow write: if false;
    }
    match /adminAuditLogs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
